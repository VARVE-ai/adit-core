{
  "name": "adit-core",
  "version": "0.2.0",
  "description": "AI Development Intent Tracker — The Transparent Time Machine",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "node scripts/prepare-package-docs.cjs && node scripts/clean-dist.cjs && pnpm --filter @varveai/adit-cli... run build && pnpm --filter @varveai/adit-local-web run build",
    "build:core": "pnpm --filter @varveai/adit-core run build",
    "build:engine": "pnpm --filter @varveai/adit-engine run build",
    "build:cli": "pnpm --filter @varveai/adit-cli run build",
    "build:cloud": "pnpm --filter @varveai/adit-cloud run build",
    "build:local": "pnpm --filter @varveai/adit-cli... build && pnpm --filter @varveai/adit-local-web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quality": "node --test scripts/quality.test.mjs",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "format:check:all": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "pnpm -r run typecheck",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "keywords": [
    "ai",
    "development",
    "flight-recorder",
    "claude-code",
    "git",
    "timeline"
  ],
  "author": "ADIT Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VARVE-ai/adit-core"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.0.18"
  }
}
