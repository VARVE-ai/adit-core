{
  "name": "adit-core",
  "version": "0.2.0",
  "description": "AI Development Intent Tracker — The Transparent Time Machine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @varveai/adit-core run build",
    "build:engine": "pnpm --filter @varveai/adit-engine run build",
    "build:hooks": "pnpm --filter @varveai/adit-hooks run build",
    "build:cli": "pnpm --filter @varveai/adit-cli run build",
    "build:plans": "pnpm --filter @varveai/adit-plans run build",
    "build:cloud": "pnpm --filter @varveai/adit-cloud run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/**/*.ts",
    "lint:fix": "eslint packages/*/src/**/*.ts --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "ai",
    "development",
    "flight-recorder",
    "claude-code",
    "git",
    "timeline"
  ],
  "author": "ADIT Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VARVE-ai/adit-core"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
