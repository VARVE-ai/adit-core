{
  "name": "@varveai/adit-cli",
  "version": "0.0.0",
  "license": "MIT",
  "description": "AI Development Intent Tracker — Transparent Time Machine for your codebase",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "local-assets",
    "install-skill.cjs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "bin": {
    "adit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VARVE-ai/adit-core.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/VARVE-ai/adit-core",
  "scripts": {
    "postinstall": "node install-skill.cjs",
    "build": "tsc",
    "prepack": "node ../../scripts/prepare-package-docs.cjs cli && pnpm --filter @varveai/adit-local-web build && pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.179",
    "@anthropic-ai/sdk": "0.104.2",
    "@varveai/adit-cloud": "workspace:*",
    "@varveai/adit-core": "workspace:*",
    "@varveai/adit-engine": "workspace:*",
    "better-sqlite3": "13.0.3",
    "commander": "^13.0.0",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.28",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
